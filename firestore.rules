rules_version = '2';
// Směnovník – pravidla pro Cloud Firestore.
// Tým = dokument tymy/{kod}. Kdo zná kód, vidí směny týmu; každý zapisuje jen svůj
// vlastní záznam (clenove/{uid} podle anonymního přihlášení). Seznam týmů nejde vypsat.
// Mistři (tymy/{kod}.mistri) zadávají akce týmu (školení, porady…) a spravují tým;
// ostatní na akce jen odpovídají ve svém záznamu (pole odpovedi).
service cloud.firestore {
  match /databases/{database}/documents {
    function prihlasen() { return request.auth != null; }
    function textDo(x, n) { return x is string && x.size() <= n; }
    function cas(x) { return x == '' || (x is string && x.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')); }

    match /tymy/{kod} {
      function platnyTym() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nazev', 'zalozeno', 'mistri']) && textDo(d.nazev, 40)
          && (!('mistri' in d) || (d.mistri is list && d.mistri.size() >= 1 && d.mistri.size() <= 20));
      }
      function mistr() { return request.auth.uid in resource.data.get('mistri', []); }
      allow get: if prihlasen();
      allow create: if prihlasen() && kod.matches('^[A-Z2-9]{8}$') && platnyTym()
        && (!('mistri' in request.resource.data) || request.resource.data.mistri == [request.auth.uid]);
      // mistr upravuje tým; tým bez mistra (založený starší verzí) si může jeden člověk převzít
      allow update: if prihlasen() && platnyTym() && (mistr()
        || (!('mistri' in resource.data) && request.resource.data.get('mistri', []) == [request.auth.uid])
        || (!('mistri' in resource.data) && !('mistri' in request.resource.data)));

      match /clenove/{uid} {
        function platnyClen() {
          let d = request.resource.data;
          return d.keys().hasOnly(['jmeno', 'barva', 'role', 'posun_dnu', 'nastaveni', 'zasahy', 'odpovedi', 'upraveno'])
            && textDo(d.jmeno, 40) && textDo(d.barva, 9) && textDo(d.role, 40)
            && d.posun_dnu is int && d.nastaveni is map
            && d.zasahy is list && d.zasahy.size() <= 400
            && (!('odpovedi' in d) || (d.odpovedi is map && d.odpovedi.size() <= 300))
            && d.upraveno is int;
        }
        allow read: if prihlasen();
        allow create, update: if prihlasen() && request.auth.uid == uid && platnyClen();
        allow delete: if prihlasen() && request.auth.uid == uid;
      }

      match /akce/{id} {
        function jeMistr() {
          return request.auth.uid in get(/databases/$(database)/documents/tymy/$(kod)).data.get('mistri', []);
        }
        function platnaAkce() {
          let d = request.resource.data;
          return d.keys().hasOnly(['datum', 'typ', 'nazev', 'od', 'do', 'misto', 'popis', 'pro', 'autor', 'upraveno'])
            && d.datum is string && d.datum.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.typ in ['skoleni', 'porada', 'prescas', 'lekar', 'jine']
            && textDo(d.nazev, 60) && cas(d.od) && cas(d.do)
            && textDo(d.misto, 60) && textDo(d.popis, 300)
            && d.pro is list && d.pro.size() <= 100
            && d.autor == request.auth.uid && d.upraveno is int;
        }
        allow read: if prihlasen();
        allow create, update: if prihlasen() && id.size() <= 40 && jeMistr() && platnaAkce();
        allow delete: if prihlasen() && jeMistr();
      }
    }
  }
}
